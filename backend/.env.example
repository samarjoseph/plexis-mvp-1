# ─── Plexis Backend Environment Configuration Template ───────────────────────
# Copy this file to .env and configure local credentials. Never commit .env.

# ── Server ──────────────────────────────────────────────────────────────────
FLASK_PORT=5000
FLASK_DEBUG=true

# ── Router Role Credentials ──────────────────────────────────────────────────
# Primary Router: Mistral Small
MISTRAL_API_KEY=
# Fallback Router: NVIDIA NIM
NVIDIA_API_KEY=

# ── Transformation Role Credentials (also Secondary Analysis/Conversation) ──
# Google Gemini Multi-Credential Pool (up to 4 slots)
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# ── Analysis & Conversation Role Credentials ─────────────────────────────────
# OpenRouter Multi-Credential Pool (up to 3 slots)
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# ── Optional Alternative Providers ──────────────────────────────────────────
GROQ_API_KEY=

# ── Model Overrides (Optional — defaults set by system) ─────────────────────
ROUTER_MISTRAL_MODEL=mistral-small-latest
ROUTER_NVIDIA_MODEL=google/diffusiongemma-26b-a4b-it
ANALYSIS_OPENROUTER_MODEL=google/gemma-2-27b-it:free
ANALYSIS_OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
ANALYSIS_GEMINI_MODEL=gemini-2.0-flash
TRANSFORMATION_GEMINI_MODEL=gemini-2.0-flash
CONVERSATION_OPENROUTER_MODEL=google/gemma-2-27b-it:free
CONVERSATION_OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
CONVERSATION_GEMINI_MODEL=gemini-2.0-flash

# ── LLM Temperature Policy ──────────────────────────────────────────────────
PLANNER_TEMPERATURE=0.0
CONVERSATION_TEMPERATURE=0.7

# ── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_FOLDER=storage/uploads
MAX_UPLOAD_SIZE_MB=35

# ── CORS & Logging ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=DEBUG

# ── Database Persistence (Optional) ─────────────────────────────────────────
DATABASE_URL=
DB_POOL_SIZE=10
ADMIN_SECRET_KEY=

# ── Object Storage: Backblaze B2 (S3-Compatible) ────────────────────────────
# Set STORAGE_PROVIDER=b2 to enable Backblaze B2. Leave unset or 'local' for local file emulation.
STORAGE_PROVIDER=b2

# Backblaze B2 Account A (Primary)
# In Backblaze B2 Console: App Keys -> Add a New Application Key (Read and Write permissions)
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=plexis-datasets
# e.g. https://s3.us-east-005.backblazeb2.com or https://s3.us-west-004.backblazeb2.com
B2_S3_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005

# Backblaze B2 Account B (Secondary / Optional Multi-Tenant Routing)
B2_B_APPLICATION_KEY_ID=
B2_B_APPLICATION_KEY=
B2_B_BUCKET_NAME=
B2_B_S3_ENDPOINT_URL=
B2_B_REGION=

# ── Storage Quotas & Zero-Budget MVP Safeguards ──────────────────────────────
# Maximum size allowed for a single dataset upload in megabytes:
MAX_UPLOAD_SIZE_MB=35
# Maximum total storage limit in megabytes tracked across Plexis (Default 10,000 MB = 10 GB free tier limit):
B2_MAX_STORAGE_MB=10000
#
# IMPORTANT BILLING CAVEAT:
# Plexis application-side quotas reject uploads before storing them to protect against accidental runaway costs.
# However, application quotas are NOT a provider-enforced hard spending cap.
# Operators must review Backblaze's pricing, transaction fees, and configure official Backblaze account spending
# caps/billing limits in the Backblaze B2 Console before opening uploads to public traffic.

# ── Spreadsheet Action History & Snapshot Policies ──────────────────────────
# Compact snapshot to B2 every N committed actions:
SNAPSHOT_INTERVAL_ACTIONS=20
# Maximum undo history depth per dataset:
MAX_ACTION_HISTORY_DEPTH=100

